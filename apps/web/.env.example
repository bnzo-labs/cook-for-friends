# =============================================================================
# Cook for Friends — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file with real secret values.
# All variables are validated at boot by src/lib/env.ts (zod).
# =============================================================================

# =============================================================================
# DATABASE (Neon)
# =============================================================================

# Pooled connection string (PgBouncer, transaction mode) — used at runtime
# Get from: Neon console → Connection Details → Pooled connection
DATABASE_URL=

# Direct connection string — used only for migrations (pnpm payload migrate)
# Get from: Neon console → Connection Details → Direct connection
DATABASE_URL_DIRECT=

# =============================================================================
# PAYLOAD CMS
# =============================================================================

# JWT and encryption secret — generate with: openssl rand -base64 32
# ROTATION: rotate only on suspected breach; invalidates all sessions
PAYLOAD_SECRET=

# =============================================================================
# STRIPE
# =============================================================================

# Secret key — get from: Stripe Dashboard → Developers → API keys
# DO NOT use a live key in development or staging
STRIPE_SECRET_KEY=

# Webhook signing secret — get from: Stripe Dashboard → Webhooks
# ROTATION: rotate annually; update in Stripe Dashboard + Vercel settings
# DEPENDENCIES: commerce module webhook handler
STRIPE_WEBHOOK_SECRET=

# Set to true once GST/QST registration numbers are added in Stripe Tax (D6)
STRIPE_TAX_ENABLED=false

# Stripe tax code for courses — confirm with accountant
# e.g. txcd_20030000 (Educational services)
STRIPE_TAX_CODE=

# =============================================================================
# EMAIL (Resend)
# =============================================================================

# Resend API key — get from: resend.com → API Keys
# ROTATION: rotate per Resend policy; update in Vercel settings
# DEPENDENCIES: all email sending (magic links, confirmations, reminders)
RESEND_API_KEY=

# Sending address — must be a verified domain in Resend
# Staging: use onboarding@resend.dev
# Production: use mail@<your-domain> (see D8 domain decision)
EMAIL_FROM=

# Reply-to address (optional)
EMAIL_REPLY_TO=

# =============================================================================
# CLOUDFLARE R2 (media storage)
# =============================================================================
# The R2 bucket is PRIVATE. Media is served through Payload's access-controlled route.
# Get credentials from: Cloudflare Dashboard → R2 → Manage R2 API tokens

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public URL for public media (images) only — not for private materials
R2_PUBLIC_URL=

# =============================================================================
# VIDEO PROVIDER
# =============================================================================

# mux | bunny | none — "none" until Wave 3 configures a provider; see DISCOVERY §5
VIDEO_PROVIDER=none

# --- Mux (required when VIDEO_PROVIDER=mux) ---
# Get from: Mux Dashboard → Settings → API Access Tokens
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
# Signing key for signed playback URLs — get from Mux Dashboard → Settings → Signing Keys
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY_PRIVATE=
# Webhook signing secret
MUX_WEBHOOK_SECRET=

# --- Bunny Stream (required when VIDEO_PROVIDER=bunny) ---
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_TOKEN_KEY=
BUNNY_CDN_HOST=

# =============================================================================
# CRON
# =============================================================================

# Secret used to authenticate Vercel Cron requests
# Generate with: openssl rand -base64 32
# ROTATION: rotate annually; update in Vercel settings
# DEPENDENCIES: /api/cron/expire-holds, /api/cron/reminders, /api/cron/jobs
CRON_SECRET=

# =============================================================================
# PUBLIC (safe for the browser)
# =============================================================================

# Canonical origin — e.g. https://cookforfriends.ca
# Used for absolute URLs in emails, OG tags, and canonical links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# CI/test only — set to "1" to skip server env validation in CI builds.
# Turbopack workers only forward NEXT_PUBLIC_* vars, so this must use that prefix.
# NEVER set to "1" in production or staging.
NEXT_PUBLIC_SKIP_ENV_VALIDATION=

# =============================================================================
# MONITORING (Sentry — optional in development, required in production)
# =============================================================================

SENTRY_DSN=
SENTRY_AUTH_TOKEN=
